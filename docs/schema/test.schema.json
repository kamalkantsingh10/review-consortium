{
  "$defs": {
    "PerceptionCheck": {
      "additionalProperties": false,
      "description": "A known answer about 1-2 Clips (story 3.2, ``kind: screening`` Tests only).\n\nA pairwise Instrument, or a single-Clip Instrument given 2 Clips, is a *pair* check:\n``expected`` is the Clip that should win. A single Clip is a *low-level* check:\n``expected`` is the answer to ``item``. ``config.load.load_test`` checks the rest.",
      "properties": {
        "clips": {
          "items": {
            "pattern": "^c_[a-z2-7]{8}$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Clips",
          "type": "array"
        },
        "expected": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ],
          "title": "Expected"
        },
        "instrument": {
          "pattern": "^[a-z0-9][a-z0-9_]*$",
          "title": "Instrument",
          "type": "string"
        },
        "item": {
          "pattern": "^[a-z0-9][a-z0-9_]*$",
          "title": "Item",
          "type": "string"
        }
      },
      "required": [
        "instrument",
        "item",
        "clips",
        "expected"
      ],
      "title": "PerceptionCheck",
      "type": "object"
    },
    "PracticeExample": {
      "additionalProperties": false,
      "description": "A Practice clip (or pair) with the intended answer shown to the Model.",
      "properties": {
        "answer": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Answer",
          "type": "object"
        },
        "clips": {
          "items": {
            "pattern": "^c_[a-z2-7]{8}$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Clips",
          "type": "array"
        },
        "instrument": {
          "pattern": "^[a-z0-9][a-z0-9_]*$",
          "title": "Instrument",
          "type": "string"
        }
      },
      "required": [
        "instrument",
        "clips",
        "answer"
      ],
      "title": "PracticeExample",
      "type": "object"
    },
    "SessionOverrides": {
      "additionalProperties": false,
      "description": "Per-Test overrides of ``study.yaml`` ``session``; unset keys inherit.",
      "properties": {
        "max_retries": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Retries"
        },
        "pairing": {
          "anyOf": [
            {
              "const": "all_pairs",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pairing"
        },
        "practice_clips": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Practice Clips"
        },
        "repeats": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repeats"
        }
      },
      "title": "SessionOverrides",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "description": "Perception checks with known answers (kind: screening only, story 3.2).",
      "items": {
        "$ref": "#/$defs/PerceptionCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "clips": {
      "items": {
        "pattern": "^c_[a-z2-7]{8}$",
        "type": "string"
      },
      "title": "Clips",
      "type": "array"
    },
    "instruments": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_]*$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Instruments",
      "type": "array"
    },
    "kind": {
      "enum": [
        "pilot",
        "screening",
        "main"
      ],
      "title": "Kind",
      "type": "string"
    },
    "models": {
      "anyOf": [
        {
          "items": {
            "pattern": "^m[1-9][0-9]*$",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Models"
    },
    "practice": {
      "items": {
        "$ref": "#/$defs/PracticeExample"
      },
      "title": "Practice",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "description": "Config file schema version.",
      "title": "Schema Version",
      "type": "integer"
    },
    "session": {
      "$ref": "#/$defs/SessionOverrides"
    },
    "test": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Test",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "test",
    "kind",
    "instruments"
  ],
  "title": "TestConfig",
  "type": "object",
  "x-schema-version": 1
}
