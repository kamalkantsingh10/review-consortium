{
  "$defs": {
    "ModelPrice": {
      "additionalProperties": false,
      "description": "Prices in USD per million tokens plus the token formula of ``core.cost`` (story 1.9).",
      "properties": {
        "chars_per_token": {
          "default": "4",
          "description": "Characters of rendered request text per input token.",
          "pattern": "^(?=.*[1-9])[0-9]+(\\.[0-9]+)?$",
          "title": "Chars Per Token",
          "type": "string"
        },
        "input_usd_per_mtok": {
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "title": "Input Usd Per Mtok",
          "type": "string"
        },
        "media_tokens_per_s": {
          "default": "300",
          "description": "Input tokens per second of Clip media.",
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "title": "Media Tokens Per S",
          "type": "string"
        },
        "output_usd_per_mtok": {
          "pattern": "^[0-9]+(\\.[0-9]+)?$",
          "title": "Output Usd Per Mtok",
          "type": "string"
        }
      },
      "required": [
        "input_usd_per_mtok",
        "output_usd_per_mtok"
      ],
      "title": "ModelPrice",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "models": {
      "additionalProperties": false,
      "patternProperties": {
        "^m[1-9][0-9]*$": {
          "$ref": "#/$defs/ModelPrice"
        }
      },
      "title": "Models",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "description": "Config file schema version.",
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "models"
  ],
  "title": "PricesConfig",
  "type": "object",
  "x-schema-version": 1
}
