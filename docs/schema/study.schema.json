{
  "$defs": {
    "BigFiveDesign": {
      "additionalProperties": false,
      "description": "The Big Five profile design (story 2.4): a fraction of the 32 profiles, replicated.\n\n``fraction`` is stored canonically as ``\"1\"``, ``\"1/2\"`` or ``\"1/4\"``.",
      "properties": {
        "fraction": {
          "default": "1",
          "enum": [
            1,
            0.5,
            0.25,
            "1",
            "1/2",
            "1/4"
          ],
          "title": "Fraction"
        },
        "replicates": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "Replicates",
          "type": "integer"
        }
      },
      "title": "BigFiveDesign",
      "type": "object"
    },
    "FakeSettings": {
      "additionalProperties": false,
      "description": "What the Fake rater reports as usage for each answer (story 1.9), how often it\nanswers invalidly (story 1.10) and how often it simulates a transient error, a\nrefusal or a fatal error (story 2.1).",
      "properties": {
        "fatal_rate": {
          "default": 0.0,
          "description": "Probability (0-1) that an attempt simulates a fatal provider error (category fatal); decided per attempt seed.",
          "maximum": 1,
          "minimum": 0,
          "title": "Fatal Rate",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "invalid_rate": {
          "default": 0.0,
          "description": "Probability (0-1) that an attempt's answer is invalid; decided per attempt seed, so deterministic.",
          "maximum": 1,
          "minimum": 0,
          "title": "Invalid Rate",
          "type": "number"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "refusal_rate": {
          "default": 0.0,
          "description": "Probability (0-1) that an attempt simulates a safety refusal (category refused); decided per attempt seed.",
          "maximum": 1,
          "minimum": 0,
          "title": "Refusal Rate",
          "type": "number"
        },
        "transient_rate": {
          "default": 0.0,
          "description": "Probability (0-1) that an attempt simulates a rate limit or transport error (category transient); decided per attempt seed.",
          "maximum": 1,
          "minimum": 0,
          "title": "Transient Rate",
          "type": "number"
        }
      },
      "title": "FakeSettings",
      "type": "object"
    },
    "LeakTolerance": {
      "additionalProperties": false,
      "description": "Allowed per-Condition differences; resolution and fps must match exactly.",
      "properties": {
        "duration_s": {
          "minimum": 0,
          "title": "Duration S",
          "type": "number"
        },
        "loudness_lufs": {
          "minimum": 0,
          "title": "Loudness Lufs",
          "type": "number"
        }
      },
      "required": [
        "duration_s",
        "loudness_lufs"
      ],
      "title": "LeakTolerance",
      "type": "object"
    },
    "MediaLimits": {
      "additionalProperties": false,
      "description": "What a Model accepts per request; ``push test`` checks every Trial against it.",
      "properties": {
        "inline_base64": {
          "default": true,
          "title": "Inline Base64",
          "type": "boolean"
        },
        "max_bytes": {
          "exclusiveMinimum": 0,
          "title": "Max Bytes",
          "type": "integer"
        },
        "max_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Seconds",
          "type": "number"
        }
      },
      "required": [
        "max_seconds",
        "max_bytes"
      ],
      "title": "MediaLimits",
      "type": "object"
    },
    "MediaProfile": {
      "additionalProperties": false,
      "description": "The one canonical encoding every Clip is re-encoded to at ingest.",
      "properties": {
        "audio_kbps": {
          "default": 64,
          "exclusiveMinimum": 0,
          "title": "Audio Kbps",
          "type": "integer"
        },
        "fps": {
          "default": 25,
          "exclusiveMinimum": 0,
          "title": "Fps",
          "type": "integer"
        },
        "height": {
          "default": 480,
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "video_kbps": {
          "default": 400,
          "exclusiveMinimum": 0,
          "title": "Video Kbps",
          "type": "integer"
        }
      },
      "title": "MediaProfile",
      "type": "object"
    },
    "ModelConfig": {
      "additionalProperties": false,
      "properties": {
        "fake": {
          "anyOf": [
            {
              "$ref": "#/$defs/FakeSettings"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fake rater settings; only for provider: fake."
        },
        "id": {
          "pattern": "^m[1-9][0-9]*$",
          "title": "Id",
          "type": "string"
        },
        "limits": {
          "$ref": "#/$defs/MediaLimits"
        },
        "max_output_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "enum": [
            "fake",
            "gemini",
            "qwen"
          ],
          "title": "Provider",
          "type": "string"
        },
        "settings": {
          "$ref": "#/$defs/ModelSettings"
        }
      },
      "required": [
        "id",
        "provider",
        "model",
        "max_output_tokens",
        "limits"
      ],
      "title": "ModelConfig",
      "type": "object"
    },
    "ModelSettings": {
      "additionalProperties": false,
      "properties": {
        "api_key_env": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Env var holding the API key (default GEMINI_API_KEY for gemini, DASHSCOPE_API_KEY for qwen); never put the key itself in a Study file.",
          "title": "Api Key Env"
        },
        "base_url": {
          "anyOf": [
            {
              "pattern": "^https?://[^\\s/?#]+[^\\s]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OpenAI-compatible endpoint (an http(s) URL); qwen only, and required for qwen (no default: the Model Studio endpoint is workspace-specific).",
          "title": "Base Url"
        },
        "fps": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Frames per second sampled from each Clip; gemini only.",
          "title": "Fps"
        },
        "media_resolution": {
          "anyOf": [
            {
              "enum": [
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Media resolution per frame; gemini only.",
          "title": "Media Resolution"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sent verbatim as reasoning_effort (and archived) only when set; qwen only.",
          "title": "Reasoning Effort"
        },
        "seed_supported": {
          "default": true,
          "description": "Send the attempt seed with each request.",
          "title": "Seed Supported",
          "type": "boolean"
        },
        "temperature": {
          "default": 0.7,
          "exclusiveMinimum": 0,
          "title": "Temperature",
          "type": "number"
        },
        "thinking_level": {
          "anyOf": [
            {
              "enum": [
                "minimal",
                "low",
                "medium",
                "high"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pinned thinking level; gemini only.",
          "title": "Thinking Level"
        }
      },
      "title": "ModelSettings",
      "type": "object"
    },
    "PersonaFrame": {
      "additionalProperties": false,
      "properties": {
        "big_five": {
          "anyOf": [
            {
              "$ref": "#/$defs/BigFiveDesign"
            },
            {
              "const": "all_32",
              "type": "string"
            }
          ],
          "default": {
            "fraction": "1",
            "replicates": 1
          },
          "description": "The profile design; the legacy value \"all_32\" means the full grid."
        },
        "nars_bands": {
          "items": {
            "enum": [
              "low",
              "high"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Nars Bands",
          "type": "array"
        },
        "quotas": {
          "$ref": "#/$defs/Quotas"
        }
      },
      "required": [
        "quotas"
      ],
      "title": "PersonaFrame",
      "type": "object"
    },
    "Quotas": {
      "additionalProperties": false,
      "properties": {
        "age_band": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Age Band",
          "type": "array"
        },
        "cultural_region": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Cultural Region",
          "type": "array"
        },
        "gender": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Gender",
          "type": "array"
        },
        "robot_experience": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Robot Experience",
          "type": "array"
        }
      },
      "required": [
        "age_band",
        "gender",
        "cultural_region",
        "robot_experience"
      ],
      "title": "Quotas",
      "type": "object"
    },
    "RetryPolicy": {
      "additionalProperties": false,
      "description": "Retries after a ``transient`` Rater result (story 2.1), separate from ``max_retries``.\n\nThe k-th transient attempt of a Trial waits ``min(backoff_max_s, backoff_initial_s *\n2^(k-1))`` seconds times a jitter in [0.5, 1.0] derived from its attempt seed.\nBoth backoff values must be finite.",
      "properties": {
        "backoff_initial_s": {
          "default": 2,
          "minimum": 0,
          "title": "Backoff Initial S",
          "type": "number"
        },
        "backoff_max_s": {
          "default": 60,
          "minimum": 0,
          "title": "Backoff Max S",
          "type": "number"
        },
        "transient_retries": {
          "default": 3,
          "minimum": 0,
          "title": "Transient Retries",
          "type": "integer"
        }
      },
      "title": "RetryPolicy",
      "type": "object"
    },
    "SessionConfig": {
      "additionalProperties": false,
      "properties": {
        "max_retries": {
          "default": 2,
          "minimum": 0,
          "title": "Max Retries",
          "type": "integer"
        },
        "pairing": {
          "const": "all_pairs",
          "default": "all_pairs",
          "title": "Pairing",
          "type": "string"
        },
        "practice_clips": {
          "default": 2,
          "minimum": 0,
          "title": "Practice Clips",
          "type": "integer"
        },
        "repeats": {
          "default": 3,
          "minimum": 1,
          "title": "Repeats",
          "type": "integer"
        },
        "retry": {
          "$ref": "#/$defs/RetryPolicy",
          "description": "Transient-error retries and backoff; study.yaml only (no per-Test override)."
        }
      },
      "title": "SessionConfig",
      "type": "object"
    },
    "Thresholds": {
      "additionalProperties": false,
      "properties": {
        "invalid_rate_max": {
          "maximum": 1,
          "minimum": 0,
          "title": "Invalid Rate Max",
          "type": "number"
        },
        "leak_tolerance": {
          "$ref": "#/$defs/LeakTolerance"
        },
        "persona_fidelity_min": {
          "maximum": 1,
          "minimum": 0,
          "title": "Persona Fidelity Min",
          "type": "number"
        }
      },
      "required": [
        "persona_fidelity_min",
        "invalid_rate_max",
        "leak_tolerance"
      ],
      "title": "Thresholds",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "concurrency": {
      "default": 4,
      "minimum": 1,
      "title": "Concurrency",
      "type": "integer"
    },
    "instruments": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Instruments",
      "type": "array"
    },
    "media": {
      "$ref": "#/$defs/MediaProfile"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/ModelConfig"
      },
      "minItems": 1,
      "title": "Models",
      "type": "array"
    },
    "personas": {
      "$ref": "#/$defs/PersonaFrame"
    },
    "schema_version": {
      "const": 1,
      "description": "Config file schema version.",
      "title": "Schema Version",
      "type": "integer"
    },
    "seed": {
      "exclusiveMaximum": 9223372036854775808,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "session": {
      "$ref": "#/$defs/SessionConfig"
    },
    "thresholds": {
      "$ref": "#/$defs/Thresholds"
    }
  },
  "required": [
    "schema_version",
    "seed",
    "instruments",
    "models",
    "thresholds",
    "personas"
  ],
  "title": "StudyConfig",
  "type": "object",
  "x-schema-version": 1
}
